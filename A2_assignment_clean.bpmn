<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="A2_Definitions" targetNamespace="http://example.com/A2"><process id="A2_Process" name="Logistics &amp; Shipment Exception Management" isExecutable="false"><laneSet id="A2_LaneSet"><lane id="A2_Lane_0" name="Shipper / Customer"><flowNodeRef>A2_N0</flowNodeRef><flowNodeRef>A2_N1</flowNodeRef><flowNodeRef>A2_N13</flowNodeRef></lane><lane id="A2_Lane_1" name="Control Tower / Dispatcher"><flowNodeRef>A2_N4</flowNodeRef></lane><lane id="A2_Lane_2" name="Pickup Agent"><flowNodeRef>A2_N5</flowNodeRef><flowNodeRef>A2_N6</flowNodeRef></lane><lane id="A2_Lane_3" name="Hub / Warehouse"><flowNodeRef>A2_N8</flowNodeRef></lane><lane id="A2_Lane_4" name="Delivery Agent / Recipient"><flowNodeRef>A2_N10</flowNodeRef><flowNodeRef>A2_N11</flowNodeRef></lane><lane id="A2_Lane_5" name="Claims Department" /><lane id="A2_Lane_6" name="Shipment Management System"><flowNodeRef>A2_N2</flowNodeRef><flowNodeRef>A2_N3</flowNodeRef><flowNodeRef>A2_N7</flowNodeRef><flowNodeRef>A2_N9</flowNodeRef><flowNodeRef>A2_N12</flowNodeRef></lane></laneSet><startEvent id="A2_N0" name="Start" /><userTask id="A2_N1" name="Create shipment booking" /><businessRuleTask id="A2_N2" name="Validate address, weight, service &amp; charges" /><exclusiveGateway id="A2_N3" name="Booking valid?" /><serviceTask id="A2_N4" name="Schedule pickup &amp; assign driver" /><manualTask id="A2_N5" name="Collect parcel &amp; scan" /><exclusiveGateway id="A2_N6" name="Pickup successful?" /><parallelGateway id="A2_N7" name="Movement + tracking update" /><subProcess id="A2_N8" name="Sort, scan &amp; transport between hubs" /><sendTask id="A2_N9" name="Out for delivery &amp; notify recipient" /><userTask id="A2_N10" name="Hand over parcel &amp; capture proof" /><exclusiveGateway id="A2_N11" name="Delivered?" /><serviceTask id="A2_N12" name="Close shipment &amp; generate invoice" /><endEvent id="A2_N13" name="Shipment delivered" /><sequenceFlow id="A2_F0" sourceRef="A2_N0" targetRef="A2_N1" /><sequenceFlow id="A2_F1" sourceRef="A2_N1" targetRef="A2_N2" /><sequenceFlow id="A2_F2" sourceRef="A2_N2" targetRef="A2_N3" /><sequenceFlow id="A2_F3" sourceRef="A2_N3" targetRef="A2_N4" /><sequenceFlow id="A2_F4" sourceRef="A2_N4" targetRef="A2_N5" /><sequenceFlow id="A2_F5" sourceRef="A2_N5" targetRef="A2_N6" /><sequenceFlow id="A2_F6" sourceRef="A2_N6" targetRef="A2_N7" /><sequenceFlow id="A2_F7" sourceRef="A2_N7" targetRef="A2_N8" /><sequenceFlow id="A2_F8" sourceRef="A2_N8" targetRef="A2_N9" /><sequenceFlow id="A2_F9" sourceRef="A2_N9" targetRef="A2_N10" /><sequenceFlow id="A2_F10" sourceRef="A2_N10" targetRef="A2_N11" /><sequenceFlow id="A2_F11" sourceRef="A2_N11" targetRef="A2_N12" /><sequenceFlow id="A2_F12" sourceRef="A2_N12" targetRef="A2_N13" /><textAnnotation id="A2_Ann0"><text>E1 Pickup: reschedule twice then cancel.</text></textAnnotation><textAnnotation id="A2_Ann1"><text>E2 Address: correct or contact recipient.</text></textAnnotation><textAnnotation id="A2_Ann2"><text>E3 Damage: inspect; claims if insured.</text></textAnnotation><textAnnotation id="A2_Ann3"><text>E4 Lost: trace after 48h; lost after 5 days.</text></textAnnotation><textAnnotation id="A2_Ann4"><text>E5 Delay: notify, reroute/alternate, update ETA.</text></textAnnotation><textAnnotation id="A2_Ann5"><text>E6 Customs: request docs for 5 days; else return.</text></textAnnotation><textAnnotation id="A2_Ann6"><text>E7 Unavailable: 3 attempts, depot 7 days, return.</text></textAnnotation><textAnnotation id="A2_Ann7"><text>E8 Refusal/COD: return and adjust charges.</text></textAnnotation><textAnnotation id="A2_Ann8"><text>E9 Scan failure: manual correction and reconciliation.</text></textAnnotation><textAnnotation id="A2_Ann9"><text>E10 Cancellation: stop, return, compensate.</text></textAnnotation></process><bpmndi: