allocated" /><sequenceFlow id="A1_F0" sourceRef="A1_N0" targetRef="A1_N1" /><sequenceFlow id="A1_F1" sourceRef="A1_N1" targetRef="A1_N2" /><sequenceFlow id="A1_F2" sourceRef="A1_N2" targetRef="A1_N3" /><sequenceFlow id="A1_F3" sourceRef="A1_N3" targetRef="A1_N4" /><sequenceFlow id="A1_F4" sourceRef="A1_N4" targetRef="A1_N5" /><sequenceFlow id="A1_F5" sourceRef="A1_N5" targetRef="A1_N6" /><sequenceFlow id="A1_F6" sourceRef="A1_N6" targetRef="A1_N7" /><sequenceFlow id="A1_F7" sourceRef="A1_N7" targetRef="A1_N8" /><sequenceFlow id="A1_F8" sourceRef="A1_N8" targetRef="A1_N9" /><sequenceFlow id="A1_F9" sourceRef="A1_N9" targetRef="A1_N10" /><sequenceFlow id="A1_F10" sourceRef="A1_N10" targetRef="A1_N11" /><sequenceFlow id="A1_F11" sourceRef="A1_N11" targetRef="A1_N12" /><sequenceFlow id="A1_F12" sourceRef="A1_N12" targetRef="A1_N13" /><sequenceFlow id="A1_F13" sourceRef="A1_N13" targetRef="A1_N14" /><textAnnotation id="A1_Ann0"><text>F1 Validation: return errors; 2 resubmissions then escalation.</text></textAnnotation><textAnnotation id="A1_Ann1"><text>F2 Team rules: reject and reform team.</text></textAnnotation><textAnnotation id="A1_Ann2"><text>F3 Duplicate topic: review, modify or reject.</text></textAnnotation><textAnnotation id="A1_Ann3"><text>F4 Deadline: timer; late request to coordinator.</text></textAnnotation><textAnnotation id="A1_Ann4"><text>F5 Revision: 7-day loop, max 2 cycles.</text></textAnnotation><textAnnotation id="A1_Ann5"><text>F6 Rejection: notify; one new topic then reject.</text></textAnnotation><textAnnotation id="A1_Ann6"><text>F7 Review delay: reminder then HoD escalation.</text></textAnnotation><textAnnotation id="A1_Ann7"><text>F8 No guide: manual/co-guide/external/waitlist.</text></textAnnotation><textAnnotation id="A1_Ann8"><text>F9 Guide decline: rerun allocation; manual after 3.</text></textAnnotation><textAnnotation id="A1_Ann9"><text>F10 System failure: retry 3 times then manual notification.</text></textAnnotation><textAnnotation id="