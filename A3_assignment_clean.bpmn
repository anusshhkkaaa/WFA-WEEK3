isk scoring" /><exclusiveGateway id="A3_N10" name="Auto / Manual / Reject" /><userTask id="A3_N11" name="Underwriter reviews &amp; approves" /><serviceTask id="A3_N12" name="Generate loan offer" /><sendTask id="A3_N13" name="Send loan offer" /><receiveTask id="A3_N14" name="Applicant accepts offer" /><userTask id="A3_N15" name="E-sign loan agreement" /><serviceTask id="A3_N16" name="Disburse funds &amp; create loan account" /><sendTask id="A3_N17" name="Notify applicant" /><endEvent id="A3_N18" name="Loan disbursed" /><sequenceFlow id="A3_F0" sourceRef="A3_N0" targetRef="A3_N1" /><sequenceFlow id="A3_F1" sourceRef="A3_N1" targetRef="A3_N2" /><sequenceFlow id="A3_F2" sourceRef="A3_N2" targetRef="A3_N3" /><sequenceFlow id="A3_F3" sourceRef="A3_N3" targetRef="A3_N4" /><sequenceFlow id="A3_F4" sourceRef="A3_N4" targetRef="A3_N5" /><sequenceFlow id="A3_F5" sourceRef="A3_N5" targetRef="A3_N6" /><sequenceFlow id="A3_F6" sourceRef="A3_N6" targetRef="A3_N7" /><sequenceFlow id="A3_F7" sourceRef="A3_N7" targetRef="A3_N8" /><sequenceFlow id="A3_F8" sourceRef="A3_N8" targetRef="A3_N9" /><sequenceFlow id="A3_F9" sourceRef="A3_N9" targetRef="A3_N10" /><sequenceFlow id="A3_F10" sourceRef="A3_N10" targetRef="A3_N11" /><sequenceFlow id="A3_F11" sourceRef="A3_N11" targetRef="A3_N12" /><sequenceFlow id="A3_F12" sourceRef="A3_N12" targetRef="A3_N13" /><sequenceFlow id="A3_F13" sourceRef="A3_N13" targetRef="A3_N14" /><sequenceFlow id="A3_F14" sourceRef="A3_N14" targetRef="A3_N15" /><sequenceFlow id="A3_F15" sourceRef="A3_N15" targetRef="A3_N16" /><sequenceFlow id="A3_F16" sourceRef="A3_N16" targetRef="A3_N17" /><sequenceFlow id="A3_F17" sourceRef="A3_N17" targetRef="A3_N18" /><textAnnotation id="A3_Ann0"><text>L1 Documents: 7-day resubmission; lapse.</text></textAnnotation><textAnnotation id="A3_Ann1"><text>L2 KYC mismatch: manual verify; reject if unresolved.</text></textAnnotation><textAnnotation id="A3_Ann2"><text>L3 Fraud/AML: investigate; confirmed case reject/terminate.</text></textAnnotation><textAnnotation id="A3_Ann3"><text>L4 Bureau: retry 3 times; manual/park.</text></textAnnotation><textAnnotation id="A3_Ann4"><text>L5 Risk: reject or counter-offer.</text></textAnnotation><textAnnotation id="A3_Ann5"><text>L6 Income/DTI: reduced amount/longer tenure; rescore once.</text></textAnnotation><textAnnotation id="A3_Ann6"><text>L7 High-value: senior committee escalation.</text></textAnnotation><textAnnotation id="A3_Ann7"><text>L8 Collateral: revalue/reduce LTV/re-underwrite.</text></textAnnotation><textAnnotation id="A3_Ann8"><text>L9 Offer timeout: expire.</text></textAnnotation><textAnnotation id="A3_Ann9"><text>L10 Withdrawal: compensate/release holds.</text></textAnnotation><textAnnotation id="A3_Ann10"><text>L11 E-sign: resend; cancel after 2 failures.</text></textAnnotation><textAnnotation id="A3_Ann11"><text>L12 Disbursement: verify/retry; hold/contact applicant.</text></textAnnotation></process><bpmndi:BPMNDiagram id="A3_Diagram"><bpmndi:BPMNPlane id="A3_Plane" bpmnElement="A3_Process"><bpmndi:BPMNShape id="A3_Lane_0_di" bpmnElement="A3_Lane_0" isHorizontal="true"><dc:Bounds x="0" y="0" width="3420" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="A3_Lane_1_di" bpmnElement="A3_Lane_1" isHorizontal="true"><dc:Bounds x="0" y="170" width="3420" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="A3_Lane_2_di" bpmnElement="A3_Lane_2" isHorizontal="true"><dc:Bounds x="0" y="340" width="3420" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="A3_Lane_3_di" bpmnElement="A3_Lane_3" isHorizontal="true"><dc:Bounds x="0" y="510" width="3420" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="A3_Lane_4_di" bpmnElement="A3_Lane_4" isHorizontal="true"><dc:Bounds x="0" y="680" width="3420" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="A3_Lane_5_di" bpmnElement="A3_Lane_5" isHorizontal="true"><dc:Bounds x="0" y="850" width="3420" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="A3_Lane_6_di" bpmnElement="A3_Lane_